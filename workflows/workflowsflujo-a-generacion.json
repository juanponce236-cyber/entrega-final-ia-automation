      "parameters": {
        "jsCode": "// Junta la Idea Semilla del disparador con las directrices recuperadas (RAG)\nconst ideaSemilla = $('1. Trigger: Idea Semilla lista').first().json['Idea Semilla'];\nconst recordId = $('1. Trigger: Idea Semilla lista').first().json.id;\n\nconst directrices = items.map(item => {\n  const f = item.json.fields || item.json;\n  return `- ${f['Tema']}: ${f['Directriz']}`;\n}).join('\\n');\n\nconst prompt = `Sos un redactor de marketing para la marca. Seguí ESTRICTAMENTE estas directrices:\\n${directrices}\\n\\nRedactá un posteo de LinkedIn breve y profesional sobre la siguiente idea:\\n\"${ideaSemilla}\"\\n\\nDevolvé solo el texto del posteo, sin explicaciones adicionales.`;\n\nreturn [{ json: { prompt, recordId, ideaSemilla } }];"
      },
      "id": "fbaf571f-1994-4b39-b3c8-1937a6c672b1",
